# Clean-Backup Environment Variables (Docker)

# -----------------------------------------------------------------------------
# REQUIRED: The absolute path on your host machine where your photos are stored.
# This directory will be mounted read-write so the app can organize them.
# -----------------------------------------------------------------------------
MEDIA_PATH=/home/user/Pictures

# -----------------------------------------------------------------------------
# Optional Overrides (defaults shown below)
# -----------------------------------------------------------------------------
# The port the web UI will be accessible on (default 8080)
# CLEAN_BACKUP_PORT=8080

# The web UI has no login, so by default it is reachable from this machine only.
# To reach it from other devices on a network you trust, publish it on all
# interfaces and open it by IP address (http://192.168.x.x:8080):
# CLEAN_BACKUP_BIND=0.0.0.0

# Opening the UI by a hostname other than localhost (e.g. http://nas.local:8080)
# requires listing that hostname here (comma-separated). IP addresses always work.
# CLEAN_BACKUP_ALLOWED_HOSTS=nas.local

# Logging level (debug, info, warning, error)
# CLEAN_BACKUP_LOG_LEVEL=info

# If you are running on a low-resource machine (e.g., Raspberry Pi) or don't 
# want the AI ML models (content classification, face detection) to load into RAM, 
# you can disable them entirely.
# CLEAN_BACKUP_DISABLE_ML=1

# Enable read-only demo mode. All mutating endpoints return 403.
# The demo database is auto-seeded and reset every 30 minutes.
# DEMO_MODE=true
